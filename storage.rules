rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function tokenIsAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role in ["admin", "super_admin"]
      );
    }

    function hasPlatformRoleClaim() {
      return request.auth != null && "role" in request.auth.token;
    }

    function isAdmin() {
      return tokenIsAdmin() || (
        request.auth != null &&
        !hasPlatformRoleClaim() &&
        currentUser().data.role in ["admin", "super_admin"]
      );
    }

    function isTrainee() {
      return request.auth != null &&
        !hasPlatformRoleClaim() &&
        currentUser().data.role == "trainee";
    }

    function isCompanyFromToken() {
      return request.auth != null &&
        request.auth.token.role == "company_admin" &&
        request.auth.token.companyDocumentId is string &&
        firestore.get(/databases/(default)/documents/companies/$(request.auth.token.companyDocumentId)).data.status != "disabled";
    }

    function ownsCertificate(certificateId) {
      return isTrainee() &&
        firestore.get(/databases/(default)/documents/certificates/$(certificateId)).data.traineeDocumentId ==
          currentUser().data.traineeDocumentId;
    }

    function ownsCompanyCertificate(certificateId) {
      return isCompanyFromToken() &&
        firestore.get(/databases/(default)/documents/certificates/$(certificateId)).data.companyDocumentId ==
          request.auth.token.companyDocumentId;
    }

    match /certificates/{certificateId}/{allPaths=**} {
      allow read: if isAdmin() || ownsCertificate(certificateId) || ownsCompanyCertificate(certificateId);
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType == "application/pdf";
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
